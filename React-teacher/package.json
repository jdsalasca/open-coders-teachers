{
  "name": "react-teacher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "deps": "knip && npm audit --audit-level=high",
    "dev": "vite",
    "dup": "jscpd src",
    "e2e": "playwright test",
    "fix": "eslint . --fix && stylelint \"**/*.scss\" --fix && prettier --write .",
    "lint": "eslint . --format=unix",
    "mutation": "stryker run",
    "preview": "vite preview",
    "size": "vite build && size-limit",
    "styles": "stylelint \"**/*.scss\"",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@size-limit/file": "^14.3.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^9.39.5",
    "eslint-formatter-unix": "^9.0.1",
    "eslint-plugin-jsdoc": "^65.4.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fast-check": "^4.10.2",
    "jscpd": "^5.4.3",
    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "prettier": "^3.10.1",
    "size-limit": "^14.3.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "size-limit": [
    {
      "path": "dist/assets/*.js",
      "limit": "120 kB"
    }
  ]
}
