{
  "name": "react-teacher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --format=unix",
    "fix": "eslint . --fix && stylelint \"**/*.scss\" --fix && prettier --write .",
    "typecheck": "tsc --noEmit",
    "styles": "stylelint \"**/*.scss\"",
    "deps": "knip && npm audit --audit-level=high"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-formatter-unix": "^9.0.1",
    "eslint-plugin-jsdoc": "^65.4.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "knip": "^6.45.1",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  }
}
